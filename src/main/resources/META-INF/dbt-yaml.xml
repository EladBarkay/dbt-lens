<idea-plugin>
    <extensions defaultExtensionNs="dev.dbt.jinja">
        <dispatchConfiguration implementation="dev.dbt.intellij.dispatch.DispatchYamlConfiguration"/>
        <resourceMetadata implementation="dev.dbt.intellij.resources.DbtYamlResourceMetadata"/>
    </extensions>
    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor language="yaml" implementation="dev.dbt.intellij.resources.DbtYamlResourceReferences"/>
    </extensions>
</idea-plugin>
