<idea-plugin>
    <id>dev.dbt.jinja</id>
    <name>dbt Lens</name>
    <vendor>dbt Lens contributors</vendor>
    <description><![CDATA[
        Jinja parsing, highlighting, folding, completion, and project macro navigation
        in SQL templates. Native SQL integration is an experimental feasibility prototype.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="dbt-sql.xml">com.intellij.database</depends>
    <depends optional="true" config-file="dbt-json.xml">com.intellij.modules.json</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="dbt Jinja" language="dbt Jinja" implementationClass="dev.dbt.intellij.lang.DbtFileType"
                  fieldName="INSTANCE" extensions="jinja;j2" patterns="*.dbt.sql"/>
        <lang.parserDefinition language="dbt Jinja" implementationClass="dev.dbt.intellij.lang.DbtParserDefinition"/>
        <lang.syntaxHighlighterFactory language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtBraceMatcher"/>
        <lang.foldingBuilder language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtFoldingBuilder"/>
        <lang.documentationProvider language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtDocumentationProvider"/>
        <colorSettingsPage implementation="dev.dbt.intellij.editor.DbtColorSettingsPage"/>
        <projectConfigurable parentId="language" id="dev.dbt.lens.settings" displayName="dbt Lens" instance="dev.dbt.intellij.config.DbtSettingsConfigurable"/>
        <iconProvider implementation="dev.dbt.intellij.config.DbtYamlIconProvider"/>
        <gotoDeclarationHandler implementation="dev.dbt.intellij.editor.DbtEnclosureNavigationHandler"/>
        <lang.findUsagesProvider language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtFindUsagesProvider"/>
        <completion.contributor language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtCompletionContributor"/>
        <annotator language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtAnnotator"/>
        <lang.substitutor language="" order="first" implementationClass="dev.dbt.intellij.project.DbtSqlLanguageSubstitutor"/>
        <fileTypeDetector implementation="dev.dbt.intellij.project.DbtSqlFileTypeDetector" order="first"/>
        <fileTypeOverrider implementation="dev.dbt.intellij.project.DbtSqlFileTypeOverrider" order="last"/>
        <fileBasedIndex implementation="dev.dbt.intellij.project.DbtMacroIndex"/>
    </extensions>
</idea-plugin>
