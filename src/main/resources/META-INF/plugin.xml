<idea-plugin>
    <id>eladbarkay.dev.dbtlens</id>
    <name>DBT Lens</name>
    <vendor url="https://github.com/EladBarkay/dbt-lens">DBT Lens contributors</vendor>
    <description><![CDATA[
        <p>Jinja-aware editing for dbt projects. DBT Lens turns the <code>.sql</code> files in a dbt project
        into templates the IDE understands, and works offline without running dbt.</p>
        <ul>
          <li><b>Jinja editing</b>: highlighting, folding, brace matching, error recovery and block templates.</li>
          <li><b>Smart completion</b>: variables in scope, macro signatures, filters, tests and dbt objects.</li>
          <li><b>Navigation</b>: Go to Declaration and Find Usages for macros, <code>ref()</code>, <code>source()</code>
            and versioned models, including installed packages.</li>
          <li><b>Adapter dispatch</b>: jump from <code>adapter.dispatch</code> to every implementation.</li>
          <li><b>YAML assistance</b>: bundled schemas for <code>dbt_project.yml</code>, profiles, packages and property files.</li>
          <li><b>Saved output</b>: compiled SQL, documentation and lineage from <code>manifest.json</code>.</li>
          <li><b>dbt commands</b>: generate the manifest and compile the current resource or the whole project.</li>
        </ul>
        <p>Works in IntelliJ IDEA and PyCharm, including the free edition. Database Tools, TextMate and YAML
        support are optional. DBT Lens is an independent project and is not affiliated with dbt Labs.</p>
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends optional="true" config-file="dbt-sql.xml">com.intellij.database</depends>
    <depends optional="true" config-file="dbt-json.xml">com.intellij.modules.json</depends>
    <depends optional="true" config-file="dbt-yaml.xml">org.jetbrains.plugins.yaml</depends>
    <extensionPoints>
        <extensionPoint qualifiedName="dev.dbt.jinja.resourceMetadata" interface="dev.dbt.intellij.resources.DbtResourceMetadata" dynamic="true"/>
        <extensionPoint qualifiedName="dev.dbt.jinja.dispatchConfiguration" interface="dev.dbt.intellij.dispatch.DispatchConfiguration" dynamic="true"/>
    </extensionPoints>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="DBT Lens" anchor="right" icon="/icons/dbt.svg" factoryClass="dev.dbt.intellij.artifacts.DbtArtifactToolWindow"/>
        <fileType name="dbt Jinja" language="dbt Jinja" implementationClass="dev.dbt.intellij.lang.DbtFileType"
                  fieldName="INSTANCE" extensions="jinja;j2" patterns="*.dbt.sql"/>
        <lang.parserDefinition language="dbt Jinja" implementationClass="dev.dbt.intellij.lang.DbtParserDefinition"/>
        <lang.syntaxHighlighterFactory language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtSyntaxHighlighterFactory"/>
        <lang.braceMatcher language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtBraceMatcher"/>
        <lang.foldingBuilder language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtFoldingBuilder"/>
        <lang.documentationProvider language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtDocumentationProvider"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/DbtDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/DbtDarcula.xml"/>
        <colorSettingsPage implementation="dev.dbt.intellij.editor.DbtColorSettingsPage"/>
        <projectConfigurable parentId="language" id="dev.dbt.lens.settings" displayName="DBT Lens" instance="dev.dbt.intellij.config.DbtSettingsConfigurable"/>
        <iconProvider implementation="dev.dbt.intellij.config.DbtYamlIconProvider"/>
        <gotoDeclarationHandler implementation="dev.dbt.intellij.dispatch.DispatchNavigationHandler"/>
        <referencesSearch implementation="dev.dbt.intellij.dispatch.DispatchUsageSearcher"/>
        <gotoDeclarationHandler implementation="dev.dbt.intellij.resources.DbtResourceNavigationHandler"/>
        <gotoDeclarationHandler implementation="dev.dbt.intellij.editor.DbtEnclosureNavigationHandler"/>
        <lang.findUsagesProvider language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtFindUsagesProvider"/>
        <completion.contributor language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtCompletionContributor"/>
        <typedHandler implementation="dev.dbt.intellij.editor.DbtTypedHandler"/>
        <enterHandlerDelegate implementation="dev.dbt.intellij.editor.DbtEnterHandler"/>
        <annotator language="dbt Jinja" implementationClass="dev.dbt.intellij.editor.DbtAnnotator"/>
        <lang.substitutor language="" order="first" implementationClass="dev.dbt.intellij.project.DbtSqlLanguageSubstitutor"/>
        <fileTypeDetector implementation="dev.dbt.intellij.project.DbtSqlFileTypeDetector" order="first"/>
        <fileTypeOverrider implementation="dev.dbt.intellij.project.DbtSqlFileTypeOverrider" order="last"/>
        <fileBasedIndex implementation="dev.dbt.intellij.project.DbtMacroIndex"/>
    </extensions>
</idea-plugin>
