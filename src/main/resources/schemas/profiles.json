{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dbt profiles",
  "description": "Common dbt profile structure. Adapter-specific connection keys are accepted.",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "target": {
        "type": "string"
      },
      "outputs": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "threads": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string"
                }
              ]
            },
            "schema": {
              "type": "string"
            },
            "database": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "port": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": true
        }
      }
    },
    "required": [
      "outputs"
    ],
    "additionalProperties": true
  }
}
